# Live inference (ADR-20261110-004): OpenRouter with BYOK (OpenAI/Anthropic keys configured in the OpenRouter dashboard)
INFERENCE_PROVIDER=openrouter        # openrouter | mock | near-ai (near-ai disabled by default; no spend)
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=            # e.g. an anthropic/... or openai/... model id validated via /models
OPENROUTER_FALLBACK_MODELS=          # comma-separated model ids
OPENROUTER_ALLOWED_PROVIDERS=openai,anthropic
INFERENCE_BUDGET_USD=5               # can only lower the hard 5.00 cap
