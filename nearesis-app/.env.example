# Names only. Real values live in the repo-root ../.env (gitignored); never commit values.
INTENTS_EXPLORER_JWT=
INTENTS_1CLICK_JWT=
NEAR_AI_API_KEY=
OUTLAYER_PAYMENT_KEY=
COINGECKO_API_KEY=
# Local stack (docker compose defaults)
DATABASE_URL=postgres://nearesis:nearesis@127.0.0.1:55432/nearesis
DATABASE_APP_URL=postgres://nearesis_app:nearesis_app@127.0.0.1:55432/nearesis
REDIS_URL=redis://127.0.0.1:56379
CLICKHOUSE_URL=http://127.0.0.1:58123
TEMPORAL_ADDRESS=127.0.0.1:57233
