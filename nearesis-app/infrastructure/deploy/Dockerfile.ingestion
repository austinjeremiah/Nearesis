# Production image: ingestion. Built from the repository root: docker build -f infrastructure/deploy/Dockerfile.ingestion .
# Base is pinned by digest (node 24.22.2, bookworm-slim). No secret enters the image: configuration is injected at run
# time (environment) and .env is excluded by the Dockerfile's .dockerignore.
FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS build
ENV CI=true COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts

FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:10001 /app /app
USER 10001:10001
CMD ["node_modules/.bin/tsx", "services/ingestion/src/scheduler/cli.ts"]
