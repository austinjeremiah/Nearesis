# Production image: web. Built from the repository root: docker build -f infrastructure/deploy/Dockerfile.web .
# Base is pinned by digest (node 24.22.3, alpine; the Debian bases carry zlib CVE-2023-45853, critical). No secret enters the image: configuration is injected at run
# time (environment) and .env is excluded by the Dockerfile's .dockerignore.
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS build
ENV CI=true COREPACK_ENABLE_DOWNLOAD_PROMPT=0
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @nearesis/web build

FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=10001:10001 /app /app
# the npm that ships in the base image (and its bundled dependencies) is not used at run time; remove it from the attack surface
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
USER 10001:10001
EXPOSE 3100
WORKDIR /app/apps/web
CMD ["../../node_modules/.bin/next", "start", "-p", "3100", "-H", "0.0.0.0"]
