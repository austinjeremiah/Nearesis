{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "parentEngine": {
      "type": "string",
      "enum": [
        "ENGINE_A",
        "ENGINE_B"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "ownedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "BLOCKED",
        "WAITING",
        "DONE",
        "FAILED",
        "STALE"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "heartbeatAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "testsPassed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "testsFailed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockerIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commitSha": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "agentId",
    "parentEngine",
    "model",
    "taskId",
    "task",
    "ownedPaths",
    "status",
    "startedAt",
    "heartbeatAt",
    "testsPassed",
    "testsFailed",
    "blockerIds",
    "commitSha"
  ],
  "additionalProperties": false
}
