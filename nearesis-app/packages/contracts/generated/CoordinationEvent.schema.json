{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "string",
      "enum": [
        "ENGINE_A",
        "ENGINE_B"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "agent.started",
        "agent.stopped",
        "subagent.spawned",
        "task.assigned",
        "task.completed",
        "test.started",
        "test.passed",
        "test.failed",
        "test.blocked",
        "finding.recorded",
        "blocker.recorded",
        "commit.created",
        "gate.passed",
        "gate.failed",
        "heartbeat"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "detail": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "ts",
    "session",
    "engine",
    "kind",
    "subject"
  ],
  "additionalProperties": false
}
