{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "queryHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "semanticModelHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSnapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "time",
              "string",
              "number",
              "decimal",
              "boolean"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "scale": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "type",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "rows": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    },
    "rowCoverage": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "unavailable"
        ]
      }
    },
    "nullCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "partialCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "sourceWatermarks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "certification": {
      "type": "string",
      "enum": [
        "certified",
        "experimental",
        "partial",
        "stale"
      ]
    },
    "cost": {
      "type": "object",
      "properties": {
        "bytesEstimated": {
          "type": "number",
          "minimum": 0
        },
        "bytesBilled": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "bytesEstimated",
        "bytesBilled"
      ],
      "additionalProperties": false
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "truncation": {
      "type": "object",
      "properties": {
        "truncated": {
          "type": "boolean",
          "const": true
        },
        "reason": {
          "type": "string",
          "const": "MAX_ROWS"
        },
        "method": {
          "type": "string",
          "enum": [
            "truncate",
            "min_max_bucket",
            "lttb"
          ]
        },
        "requestedRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requestedRowsIsLowerBound": {
          "type": "boolean"
        },
        "returnedRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "truncated",
        "reason",
        "method",
        "requestedRows",
        "returnedRows",
        "maxRows"
      ],
      "additionalProperties": false
    },
    "metricStatus": {
      "type": "string",
      "enum": [
        "draft",
        "validated"
      ]
    },
    "exploratory": {
      "type": "object",
      "properties": {
        "banner": {
          "type": "string",
          "minLength": 1
        },
        "metricKey": {
          "type": "string"
        },
        "metricVersion": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "proposalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "banner",
        "metricKey",
        "metricVersion",
        "proposalHash"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "queryHash",
    "semanticVersion",
    "semanticModelHash",
    "sourceSnapshotId",
    "columns",
    "rows",
    "nullCount",
    "partialCount",
    "gaps",
    "sourceWatermarks",
    "certification",
    "cost",
    "planFingerprint",
    "generatedAt"
  ],
  "additionalProperties": false
}
