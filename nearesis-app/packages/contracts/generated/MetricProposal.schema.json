{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "sources": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "joins": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "left": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "column": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "required": [
              "table",
              "column"
            ],
            "additionalProperties": false
          },
          "right": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "column": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "required": [
              "table",
              "column"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "left",
          "right"
        ],
        "additionalProperties": false
      }
    },
    "entityGrain": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "global",
            "column"
          ]
        },
        "column": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "column": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "table",
            "column"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    },
    "timeGrain": {
      "type": "object",
      "properties": {
        "column": {
          "type": "object",
          "properties": {
            "table": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "column": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "table",
            "column"
          ],
          "additionalProperties": false
        },
        "grain": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ]
        }
      },
      "required": [
        "column",
        "grain"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "column": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "required": [
          "table",
          "column"
        ],
        "additionalProperties": false
      }
    },
    "filters": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "column": {
            "type": "object",
            "properties": {
              "table": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              },
              "column": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,63}$"
              }
            },
            "required": [
              "table",
              "column"
            ],
            "additionalProperties": false
          },
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "neq",
              "gt",
              "gte",
              "lt",
              "lte",
              "in",
              "is_null",
              "not_null"
            ]
          },
          "values": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        },
        "required": [
          "column",
          "op",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "aggregations": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "fn": {
            "type": "string",
            "enum": [
              "sum",
              "count",
              "count_distinct",
              "avg",
              "min",
              "max"
            ]
          },
          "column": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "table": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  },
                  "column": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                  }
                },
                "required": [
                  "table",
                  "column"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "fn",
          "column"
        ],
        "additionalProperties": false
      }
    },
    "formula": {
      "$ref": "#/$defs/__schema0"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "precision": {
      "type": "object",
      "properties": {
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "rounding": {
          "type": "string",
          "enum": [
            "half_even",
            "truncate"
          ]
        }
      },
      "required": [
        "decimals",
        "rounding"
      ],
      "additionalProperties": false
    },
    "nullSemantics": {
      "type": "object",
      "properties": {
        "nullInput": {
          "type": "string",
          "enum": [
            "ignore",
            "propagate"
          ]
        },
        "emptyBucket": {
          "type": "string",
          "enum": [
            "null",
            "zero_when_coverage_complete"
          ]
        }
      },
      "required": [
        "nullInput",
        "emptyBucket"
      ],
      "additionalProperties": false
    },
    "dedup": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "final",
            "none_declared_unique"
          ]
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "historicalValidity": {
      "type": "object",
      "properties": {
        "validFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "validTo": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "restatement": {
          "type": "string",
          "enum": [
            "immutable",
            "may_restate"
          ]
        }
      },
      "required": [
        "validFrom",
        "validTo",
        "restatement"
      ],
      "additionalProperties": false
    },
    "costEstimate": {
      "type": "object",
      "properties": {
        "maxEstimatedRows": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 50000000
        }
      },
      "required": [
        "maxEstimatedRows"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*@\\d+$"
      }
    },
    "tests": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "reconcile_raw"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "expected_value"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "bucket": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "value": {
                "type": "string",
                "pattern": "^-?\\d+(?:\\.\\d+)?$"
              },
              "tolerance": {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$"
              }
            },
            "required": [
              "kind",
              "name",
              "bucket",
              "value",
              "tolerance"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "non_negative"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "min_rows"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "rows": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 100000
              }
            },
            "required": [
              "kind",
              "name",
              "rows"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "author": {
      "type": "object",
      "properties": {
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "kind": {
          "type": "string",
          "enum": [
            "human",
            "agent",
            "service"
          ]
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "principalId",
        "kind",
        "tenantId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "namespace",
    "name",
    "displayName",
    "description",
    "sources",
    "joins",
    "entityGrain",
    "timeGrain",
    "dimensions",
    "filters",
    "aggregations",
    "unit",
    "precision",
    "nullSemantics",
    "dedup",
    "historicalValidity",
    "costEstimate",
    "dependencies",
    "tests",
    "limitations",
    "version",
    "author"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agg"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "const"
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "maxLength": 50
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "op"
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "sub",
                "mul",
                "div"
              ]
            },
            "left": {
              "$ref": "#/$defs/__schema0"
            },
            "right": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
