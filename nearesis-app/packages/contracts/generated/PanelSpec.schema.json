{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "panelId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "timeSeries",
        "candlestick",
        "bar",
        "scatter",
        "heatmap",
        "cohort",
        "evidenceGraph",
        "table",
        "note",
        "waterfall"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 180
    },
    "queryRef": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semanticVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "snapshotPolicy": {
          "default": "live",
          "type": "string",
          "enum": [
            "live",
            "pinned"
          ]
        }
      },
      "required": [
        "hash",
        "semanticVersion"
      ],
      "additionalProperties": false
    },
    "dataBinding": {
      "type": "object",
      "properties": {
        "fields": {
          "minItems": 1,
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
          }
        },
        "units": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 40
          }
        },
        "timezone": {
          "type": "string",
          "const": "UTC"
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      },
      "required": [
        "fields",
        "units",
        "timezone",
        "completeness"
      ],
      "additionalProperties": false
    },
    "encoding": {
      "type": "object",
      "properties": {
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
        },
        "y": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
          }
        },
        "series": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
        },
        "tooltip": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$"
          }
        },
        "scale": {
          "type": "string",
          "enum": [
            "linear",
            "log",
            "index_100"
          ]
        },
        "aggregation": {
          "type": "string",
          "enum": [
            "none",
            "sum",
            "avg",
            "min",
            "max"
          ]
        },
        "interpolateGaps": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "additionalProperties": false
    },
    "refreshPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "on_watermark",
            "manual",
            "pinned"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "provenanceRequired": {
      "type": "boolean",
      "const": true
    },
    "note": {
      "type": "string",
      "maxLength": 20000
    }
  },
  "required": [
    "panelId",
    "schemaVersion",
    "kind",
    "title",
    "queryRef",
    "dataBinding",
    "encoding",
    "layout",
    "refreshPolicy",
    "provenanceRequired"
  ],
  "additionalProperties": false
}
