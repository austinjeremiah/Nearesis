{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "agentRole": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "contradicted",
        "mixed",
        "insufficient_data",
        "cannot_compute",
        "unverified"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "facts": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "resultRef": {
            "type": "object",
            "properties": {
              "queryHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "semanticVersion": {
                "type": "string"
              },
              "rowIds": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "column": {
                "type": "string"
              }
            },
            "required": [
              "queryHash",
              "semanticVersion",
              "rowIds",
              "column"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "value",
          "unit",
          "resultRef"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "workspaceId",
    "runId",
    "agentRole",
    "status",
    "statement",
    "facts",
    "limitations",
    "createdAt"
  ],
  "additionalProperties": false
}
