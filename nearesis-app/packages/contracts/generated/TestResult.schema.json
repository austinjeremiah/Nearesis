{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "testId": {
      "type": "string",
      "pattern": "^(BOOT|K|D|S|A|C|M|Q|W|V|B|SEC|PERF|N)\\d{2}$"
    },
    "phase": {
      "type": "string"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "executedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "fixtureHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "runtimeVersions": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_DEPENDENCY",
        "NOT_RUN"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "testId",
    "phase",
    "runId",
    "executedAt",
    "command",
    "fixtureHash",
    "commitSha",
    "runtimeVersions",
    "environment",
    "expected",
    "observed",
    "verdict",
    "evidenceRefs",
    "failureReason"
  ],
  "additionalProperties": false
}
