  {
    "id": "H003",
    "split": "heldout",
    "category": "intents",
    "difficulty": "hard",
    "prompt": "Can we tell from the data how long NEAR Intents transfers took from deposit to final delivery?",
    "kind": "run",
    "requiredSources": ["intents_swaps"],
    "minAnswerProperties": [
      "states what is timed and that delivery on the destination chain is not observed, or that no such timestamp exists"
    ],
    "acceptableRefusals": [
      {
        "state": "PARTIAL",
        "reasonCodes": ["CANNOT_COMPUTE"],
        "condition": "the catalogue or source lacks the needed field, so the system abstains and says what is missing"
      },
      {
        "state": "BLOCKED_SOURCE",
        "reasonCodes": [],
        "condition": "a source the question reads is not healthy, so the run is refused before any number is shown"
      }
    ],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [
      {
        "id": "invented_duration",
        "pattern": "\\b(median|average|p50|p95) settlement (time|duration) (is|was) \\d",
        "flags": "i",
        "why": "no second per-swap timestamp exists"
      },
      {
        "id": "delivery_claim",
        "pattern": "\\b(delivered|arrived) (in|after) \\d",
        "flags": "i",
        "why": "destination delivery time is not observed"
      }
    ],
    "acceptanceTests": ["A19", "B13"],
    "expect": {
      "outcome": "either",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false
    },
    "probes": [
      {
        "kind": "api_field",
        "label": "API either measures with a stated definition or reports CANNOT_COMPUTE",
        "api": "/v1/intents/settlement-duration?from=2026-09-13&to=2026-10-12",
        "json": "status",
        "httpStatus": 200,
        "matches": "^(OK|CANNOT_COMPUTE)$"
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  },
