[
  {
    "id": "H001",
    "split": "heldout",
    "category": "intents",
    "difficulty": "medium",
    "prompt": "Between mid-September and mid-October 2026, how many NEAR Intents swaps completed successfully, and what share ended in a refund?",
    "kind": "run",
    "requiredSources": ["intents_swaps"],
    "minAnswerProperties": [
      "success and refunded counts for the stated window",
      "refund share defined over terminal swaps"
    ],
    "acceptableRefusals": [
      {
        "state": "BLOCKED_SOURCE",
        "reasonCodes": [],
        "condition": "a source the question reads is not healthy, so the run is refused before any number is shown"
      }
    ],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [
      {
        "id": "causal_claim",
        "pattern": "\\b(caused by|because of|is driven by|was driven by|due to the)\\b",
        "flags": "i",
        "why": "descriptive aggregates do not establish causation"
      },
      {
        "id": "zero_for_unknown",
        "pattern": "\\b(no activity|zero activity|nothing happened|0 swaps)\\b",
        "flags": "i",
        "why": "a day or field without data is unknown, not zero"
      }
    ],
    "acceptanceTests": ["A19", "B07"],
    "expect": {
      "outcome": "either",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false,
      "panelPattern": "swap|refund|intents"
    },
    "probes": [
      {
        "kind": "ch_equals",
        "label": "success count",
        "api": "/v1/intents/summary?from=2026-09-13&to=2026-10-12",
        "json": "data.success",
        "ch": "SELECT count() FROM intents_swaps FINAL WHERE created_day BETWEEN '2026-09-13' AND '2026-10-12' AND status = 'SUCCESS'",
        "rel": 0
      },
      {
        "kind": "ch_equals",
        "label": "refunded count",
        "api": "/v1/intents/summary?from=2026-09-13&to=2026-10-12",
        "json": "data.refunded",
        "ch": "SELECT count() FROM intents_swaps FINAL WHERE created_day BETWEEN '2026-09-13' AND '2026-10-12' AND status = 'REFUNDED'",
        "rel": 0
      },
      {
        "kind": "sum_equals",
        "label": "statuses partition swaps",
        "api": "/v1/intents/summary?from=2026-09-13&to=2026-10-12",
        "parts": ["data.success", "data.refunded", "data.failed", "data.inFlight"],
        "abs": 0,
        "total": "data.swaps"
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  },
