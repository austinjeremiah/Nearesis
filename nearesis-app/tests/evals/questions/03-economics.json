[
  {
    "id": "Q013",
    "split": "dev",
    "category": "economics",
    "difficulty": "medium",
    "prompt": "Are increased NEAR transactions accompanied by increased fee activity?",
    "kind": "run",
    "requiredSources": ["near_economics_tx_daily", "near_economics_outcomes_daily"],
    "minAnswerProperties": [
      "either a paired comparison of transactions and fee burn or a refusal naming the missing economics tables"
    ],
    "acceptableRefusals": [
      {
        "state": "PARTIAL",
        "reasonCodes": ["CANNOT_COMPUTE"],
        "condition": "the catalogue or source lacks the needed field, so the system abstains and says what is missing"
      },
      {
        "state": "BLOCKED_SOURCE",
        "reasonCodes": [],
        "condition": "a source the question reads is not healthy, so the run is refused before any number is shown"
      },
      {
        "state": "PARTIAL",
        "reasonCodes": ["INSUFFICIENT_DATA", "CANNOT_COMPUTE"],
        "condition": "coverage is too thin for the requested window"
      }
    ],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [
      {
        "id": "invented_fee",
        "pattern": "\\b(gas|fees?) (rose|fell|increased|decreased|totalled?) (by|to) \\d",
        "flags": "i",
        "why": "economics tables are not loaded; any fee number is fabricated"
      },
      {
        "id": "causal_claim",
        "pattern": "\\b(caused by|because of|is driven by|was driven by|due to the)\\b",
        "flags": "i",
        "why": "descriptive aggregates do not establish causation"
      }
    ],
    "acceptanceTests": ["A19", "B13"],
    "expect": {
      "outcome": "refusal",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false
    },
    "probes": [
      {
        "kind": "ch_check",
        "label": "economics outcomes table is empty (gas and fee pilot not approved)",
        "ch": "SELECT count() FROM near_economics_outcomes_daily",
        "expect": 0,
        "precondition": true
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  },
