  {
    "id": "Q015",
    "split": "dev",
    "category": "economics",
    "difficulty": "medium",
    "prompt": "Are higher NEAR activity counts primarily due to high-frequency accounts?",
    "kind": "run",
    "requiredSources": ["account_daily_activity", "account_daily_head"],
    "minAnswerProperties": [
      "splits organic transactions into head (>= threshold) and tail accounts",
      "states the head threshold"
    ],
    "acceptableRefusals": [
      {
        "state": "PARTIAL",
        "reasonCodes": ["CANNOT_COMPUTE"],
        "condition": "the catalogue or source lacks the needed field, so the system abstains and says what is missing"
      }
    ],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [
      {
        "id": "account_as_person",
        "pattern": "\\b(users|people|humans) (grew|increased|doubled)\\b",
        "flags": "i",
        "why": "accounts are not people"
      },
      {
        "id": "causal_claim",
        "pattern": "\\b(caused by|because of|is driven by|was driven by|due to the)\\b",
        "flags": "i",
        "why": "descriptive aggregates do not establish causation"
      }
    ],
    "acceptanceTests": ["A19", "B13"],
    "expect": {
      "outcome": "either",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false,
      "panelPattern": "head|high.frequency|signer|account"
    },
    "probes": [
      {
        "kind": "api_field",
        "label": "high-frequency view states its threshold",
        "api": "/v1/accounts/high-frequency?days=30",
        "json": "meta.headThreshold",
        "httpStatus": 200,
        "equals": 100
      },
      {
        "kind": "range",
        "label": "top-5% share is a proportion",
        "api": "/v1/accounts/concentration?days=30",
        "json": "daily[0].top5PctShare",
        "min": 0,
        "max": 1
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  },
