[
  {
    "id": "Q025",
    "split": "dev",
    "category": "dynamic_analytics",
    "difficulty": "medium",
    "prompt": "Can the system construct a previously undefined NEAR account-activity metric?",
    "kind": "http",
    "requiredSources": ["metric authoring"],
    "minAnswerProperties": [
      "a typed proposal is compiled by the allowlisted compiler and stored as VALIDATED, never CERTIFIED, with the caller as author"
    ],
    "acceptableRefusals": [],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [],
    "acceptanceTests": ["A19", "S01"],
    "expect": {
      "outcome": "answer",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false
    },
    "probes": [],
    "http": [
      {
        "as": "owner",
        "method": "POST",
        "path": "/v1/workspaces/{WS}/metrics/proposals",
        "expectStatus": 201,
        "expectBody": [
          {
            "json": "record.status",
            "matches": "^(DRAFT|VALIDATED)$"
          },
          {
            "json": "record.certifiedAt",
            "equals": null
          }
        ],
        "body": {
          "proposal": {
            "schemaVersion": 1,
            "namespace": "authored",
            "name": "evalacct_{TAG}",
            "displayName": "Eval account activity",
            "description": "Total NEAR transactions per UTC day from the deduplicated daily table.",
            "sources": ["near_daily_tx"],
            "joins": [],
            "entityGrain": {
              "kind": "global"
            },
            "timeGrain": {
              "column": {
                "table": "near_daily_tx",
                "column": "block_date"
              },
              "grain": "day"
            },
            "dimensions": [],
            "filters": [],
            "aggregations": [
              {
                "id": "tx",
                "fn": "sum",
                "column": {
                  "table": "near_daily_tx",
                  "column": "tx_count"
                }
              }
            ],
            "unit": "tx",
            "precision": {
              "decimals": 0,
              "rounding": "half_even"
            },
            "nullSemantics": {
              "nullInput": "ignore",
              "emptyBucket": "null"
            },
            "dedup": {
              "strategy": "final"
            },
            "historicalValidity": {
              "validFrom": "2025-11-10",
              "validTo": null,
              "restatement": "may_restate"
            },
            "costEstimate": {
              "maxEstimatedRows": 100000
            },
            "dependencies": [],
            "tests": [
              {
                "kind": "reconcile_raw",
                "name": "matches raw"
              },
              {
                "kind": "non_negative",
                "name": "no negatives"
              }
            ],
            "limitations": [
              "Counts transactions as delivered by the daily source; later restatements change history."
            ],
            "version": 1
          },
          "validate": true
        }
      }
    ]
  },
