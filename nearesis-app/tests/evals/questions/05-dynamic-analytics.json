  {
    "id": "Q027",
    "split": "dev",
    "category": "dynamic_analytics",
    "difficulty": "hard",
    "prompt": "Can the system detect overlapping entity classifications in the NEAR ecosystem registry?",
    "kind": "run",
    "requiredSources": ["entities", "entity_mappings"],
    "minAnswerProperties": [
      "ambiguous (multi-entity) interactions are reported as their own class and never counted twice"
    ],
    "acceptableRefusals": [
      {
        "state": "PARTIAL",
        "reasonCodes": ["CANNOT_COMPUTE"],
        "condition": "the catalogue or source lacks the needed field, so the system abstains and says what is missing"
      }
    ],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": ["a receiver maps to at most one entity at a time"],
    "forbiddenClaims": [
      {
        "id": "causal_claim",
        "pattern": "\\b(caused by|because of|is driven by|was driven by|due to the)\\b",
        "flags": "i",
        "why": "descriptive aggregates do not establish causation"
      }
    ],
    "acceptanceTests": ["A19", "B13"],
    "expect": {
      "outcome": "either",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false,
      "panelPattern": "entity|ambiguous|overlap|classif"
    },
    "probes": [
      {
        "kind": "ch_equals",
        "label": "ambiguous interactions are zero exactly when no exact mapping assigns one account to two current entities",
        "api": "/v1/entities/coverage",
        "json": "coverage.ambiguousInteractions",
        "ch": "SELECT count() FROM (SELECT account FROM entity_mappings FINAL WHERE effective_to IS NULL AND match_type = 'exact' GROUP BY account HAVING uniqExact(entity_id) > 1)",
        "rel": 0
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  },
