  {
    "id": "Q029",
    "split": "dev",
    "category": "dynamic_analytics",
    "difficulty": "medium",
    "prompt": "What visualization fits a daily NEAR transaction count series, and what fits an Intents chain-pair matrix?",
    "kind": "run",
    "requiredSources": ["near_daily_tx", "intents_swaps"],
    "minAnswerProperties": [
      "a time series or bar for the daily series, a matrix/heatmap or ranked bars for chain pairs, chosen from result shape",
      "encodings name units"
    ],
    "acceptableRefusals": [],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [],
    "acceptanceTests": ["A19", "S05", "PERF06"],
    "expect": {
      "outcome": "answer",
      "minPanels": 1,
      "maxUsd": 0.08,
      "reproducible": false,
      "panelPattern": "timeSeries|bar|heatmap|table"
    },
    "probes": [
      {
        "kind": "api_field",
        "label": "daily series has a time column and a numeric measure",
        "api": "/v1/intents/trend?from=2026-10-13&to=2026-11-11&granularity=day",
        "json": "data[0].period",
        "httpStatus": 200,
        "matches": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  },
