      {
        "kind": "ch_equals",
        "label": "independent count is also zero",
        "api": "/v1/intents/summary?from=2024-01-01&to=2024-01-31",
        "json": "data.swaps",
        "ch": "SELECT count() FROM intents_swaps FINAL WHERE created_day BETWEEN '2024-01-01' AND '2024-01-31'",
        "rel": 0
      }
    ],
    "http": [
      {
        "as": "owner",
        "method": "GET",
        "path": "/v1/intents/summary?from=2024-01-01&to=2024-01-31",
        "expectStatus": 200,
        "expectBody": [
          {
            "json": "coverage.completeDays",
            "equals": 0
          },
          {
            "json": "coverage.missingDays[0]",
            "equals": "2024-01-01"
          }
        ]
      }
    ]
