  {
    "id": "Q047",
    "split": "dev",
    "category": "historical_validity",
    "difficulty": "hard",
    "prompt": "Report NEAR Intents activity for a window that starts before the dataset does, and say what is known.",
    "kind": "run",
    "requiredSources": ["intents_swaps", "source_coverage"],
    "minAnswerProperties": ["the part before the dataset start is reported as unavailable, not as zero"],
    "acceptableRefusals": [
      {
        "state": "PARTIAL",
        "reasonCodes": ["INSUFFICIENT_DATA", "CANNOT_COMPUTE"],
        "condition": "coverage is too thin for the requested window"
      },
      {
        "state": "PARTIAL",
        "reasonCodes": ["CANNOT_COMPUTE"],
        "condition": "the catalogue or source lacks the needed field, so the system abstains and says what is missing"
      },
      {
        "state": "BLOCKED_SOURCE",
        "reasonCodes": [],
        "condition": "a source the question reads is not healthy, so the run is refused before any number is shown"
      }
    ],
    "requiredProvenance": ["panel.queryRef.hash", "panel.dataBinding.completeness"],
    "invariants": [],
    "forbiddenClaims": [
      {
        "id": "zero_for_unknown",
        "pattern": "\\b(no activity|zero activity|nothing happened|0 swaps)\\b",
        "flags": "i",
        "why": "a day or field without data is unknown, not zero"
      }
    ],
    "acceptanceTests": ["Q03", "V14", "B09"],
    "expect": {
      "outcome": "either",
      "minPanels": 1,
      "maxUsd": 0.05,
      "reproducible": false
    },
    "probes": [
      {
        "kind": "api_field",
        "label": "window before coverage has no complete days",
        "api": "/v1/intents/summary?from=2025-01-01&to=2025-01-31",
        "json": "coverage.completeDays",
        "httpStatus": 200,
        "equals": 0
      }
    ],
    "run": {
      "as": "owner",
      "source": "live",
      "snapshotPolicy": "live"
    }
  }
]
